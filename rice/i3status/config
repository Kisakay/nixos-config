general {
    colors = true
    interval = 5
}

order += "wireless _first_"
order += "cpu_temperature 0"
order += "battery all"
order += "volume master"
order += "tztime local"

wireless _first_ {
    format_up = "📶 %quality %essid"
    format_down = "📶 off"
}

cpu_temperature 0 {
    format = "🌡 %degrees°C"
    path = "/sys/devices/platform/FRMWC004:00/cros-ec-dev.0.auto/cros-ec-hwmon.8.auto/hwmon/hwmon8/temp1_input"
    max_threshold = 80
}

battery all {
    format = "🔋 %percentage"
    format_down = "no battery"
}

volume master {
    format = "🔊 %volume"
    format_muted = "🔇 muted"
}

tztime local {
    format = "🕒 %H:%M"
}

