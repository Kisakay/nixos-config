{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "~/.config/fastfetch/trans-nixos-logo.txt"
  },
  "display": {
    "separator": " > ",
    "color": {
      "keys": "38;2;91;206;250",
      "title": "38;2;245;169;184"
    }
  },
  "modules": [
    {
      "type": "title",
      "color": {
        "user": "38;2;245;169;184",
        "at": "white",
        "host": "38;2;91;206;250"
      }
    },
    "separator",
{ "type": "os",        "key": "  OS       " },
{ "type": "kernel",    "key": "  Kernel   " },
{ "type": "shell",     "key": "  Shell    " },
{ "type": "terminal",  "key": "  Terminal " },
{ "type": "cpu",       "key": "  CPU      ", "format": "{name}" },
{ "type": "memory",    "key": "  Memory   " },
{ "type": "disk",      "key": "  Disk     " },
{ "type": "uptime",    "key": "  Uptime   " },
{ "type": "localip",   "key": "  Local IP " },
    "break"
  ]
}
